{
  "entities": {
    "AllowlistEntry": {
      "title": "AllowlistEntry",
      "description": "Controle de acesso autorizado ao CRM do HiperReforço",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "E-mail do usuário autorizado"
        },
        "ativo": {
          "type": "boolean",
          "description": "Status de acesso"
        }
      },
      "required": ["email", "ativo"]
    },
    "InterviewRecord": {
      "title": "InterviewRecord",
      "description": "Registro da entrevista",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roteiro": { "type": "string" }
      }
    },
    "PublicSubmission": {
      "title": "PublicSubmission",
      "description": "Submissão de formulário público",
      "type": "object",
      "properties": {
        "id": { "type": "string" }
      }
    },
    "ValidationToken": {
      "title": "ValidationToken",
      "description": "Token de uso único para formulário",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "usado": { "type": "boolean" },
        "roteiro": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/allowlist/{email}": {
      "schema": "AllowlistEntry",
      "description": "Lista de e-mails autorizados"
    },
    "/validacao_entrevistas/{id}": {
      "schema": "InterviewRecord",
      "description": "Entrevistas do CRM"
    },
    "/validacao_respostas/{id}": {
      "schema": "PublicSubmission",
      "description": "Submissões públicas"
    },
    "/validacao_tokens/{token}": {
      "schema": "ValidationToken",
      "description": "Tokens de uso único"
    },
    "/validacao_notificacoes/{id}": {
      "description": "Registro de auditoria de notificações enviadas por e-mail"
    },
    "/validacao_config/{docId}": {
      "description": "Configurações do sistema como chaves e destinatários de e-mail"
    }
  }
}
