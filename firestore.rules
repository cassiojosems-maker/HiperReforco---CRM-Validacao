rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Funções auxiliares
    function isSignedIn() { return request.auth != null; }
    function isAllowed() {
      return isSignedIn() && (
        request.auth.token.email == 'cassiojosems@gmail.com' ||
        (exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/allowlist/$(request.auth.token.email)).data.ativo == true)
      );
    }

    // 0. Bloqueio padrão global (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. allowlist: leitura para usuários autenticados
    match /allowlist/{email} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 2. validacao_entrevistas: apenas para e-mail na allowlist ou owner
    match /validacao_entrevistas/{id} {
      allow read, write: if isAllowed();
    }

    // 3. validacao_respostas: escrita pública (via formulário/token), leitura apenas para autorizados
    match /validacao_respostas/{id} {
      allow create: if true;
      allow read: if isAllowed();
    }
    
    // 4. validacao_tokens
    match /validacao_tokens/{token} {
      allow read, write: if true;
    }
  }
}
